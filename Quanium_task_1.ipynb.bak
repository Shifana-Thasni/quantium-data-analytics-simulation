   ],
   "source": [
    "segment1 = merged[(merged['LIFESTAGE'] == 'YOUNG SINGLES/COUPLES') & (merged['PREMIUM_CUSTOMER'] == 'Mainstream')]\n",
    "other = merged[~((merged['LIFESTAGE'] == 'YOUNG SINGLES/COUPLES') & (merged['PREMIUM_CUSTOMER'] == 'Mainstream'))]\n",
    "\n",
    "qty_segment1 = segment1['PROD_QTY'].sum()\n",
    "qty_other = other['PROD_QTY'].sum()\n",
    "\n",
    "brand_segment1 = segment1.groupby('BRAND')['PROD_QTY'].sum() / qty_segment1\n",
    "brand_other = other.groupby('BRAND')['PROD_QTY'].sum() / qty_other\n",
    "\n",
    "brand_affinity = pd.DataFrame({'target_segment': brand_segment1, 'other': brand_other})\n",
    "brand_affinity['affinity'] = brand_affinity['target_segment'] / brand_affinity['other']\n",
    "brand_affinity = brand_affinity.sort_values('affinity', ascending=False)\n",
    "brand_affinity"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "id": "82f1bbf6",
   "source": [
