   ],
   "source": [
    "standout = merged[(merged['LIFESTAGE'] == 'OLDER FAMILIES') & (merged['PREMIUM_CUSTOMER'] == 'Budget')]\n",
    "\n",
    "print(\"Number of transactions:\", len(standout))\n",
    "print(\"Number of unique customers:\", standout['LYLTY_CARD_NBR'].nunique())\n",
    "print(\"Total sales: $\", standout['TOT_SALES'].sum())\n",
    "print()\n",
    "print(\"Top 5 brands by sales in this segment:\")\n",
    "print(standout.groupby('BRAND')['TOT_SALES'].sum().sort_values(ascending=False).head(5))\n",
    "print()\n",
    "print(\"Average pack size in this segment:\", standout['PACK_SIZE'].mean())\n",
    "print(\"Average price per unit in this segment:\", standout['PRICE_PER_UNIT'].mean())"
   ]
  },
