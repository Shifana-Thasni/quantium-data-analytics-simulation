   ],
   "source": [
    "units_per_cust = merged.groupby(['LIFESTAGE', 'PREMIUM_CUSTOMER']).apply(\n",
    "    lambda x: x['PROD_QTY'].sum() / x['LYLTY_CARD_NBR'].nunique()\n",
    ").reset_index(name='AVG_UNITS_PER_CUSTOMER')\n",
    "units_per_cust = units_per_cust.sort_values('AVG_UNITS_PER_CUSTOMER', ascending=False)\n",
    "units_per_cust"
   ]
  },
