   "source": [
    "brand_sales = merged.groupby(['LIFESTAGE', 'PREMIUM_CUSTOMER', 'BRAND'])['TOT_SALES'].sum().reset_index()\n",
    "brand_sales = brand_sales.sort_values(['LIFESTAGE', 'PREMIUM_CUSTOMER', 'TOT_SALES'], ascending=[True, True, False])\n",
    "top_brand_by_segment = brand_sales.groupby(['LIFESTAGE', 'PREMIUM_CUSTOMER']).head(1)\n",
    "top_brand_by_segment"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "id": "1e8f0489",
   "source": [
    "Plot total sales per segment as a horizontal bar chart \u2014 an easier-to-read alternative to the heatmap for ranking segments."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 73,
   "id": "dc3dbc1f",
   "metadata": {},
   "outputs": [
    {
     "data": {
