   "source": [
    "pack_by_segment = merged.groupby(['LIFESTAGE', 'PREMIUM_CUSTOMER'])['PACK_SIZE'].mean().reset_index()\n",
    "pack_by_segment = pack_by_segment.sort_values('PACK_SIZE', ascending=False)\n",
    "pack_by_segment"
   ]
  },
