     },
     "execution_count": 62,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "merged = pd.merge(transactions, customers, on='LYLTY_CARD_NBR', how='left')\n",
    "print(merged.shape)\n",
    "merged.isnull().sum()"
   ]
  },
