      "text/plain": [
       "<Figure size 1400x600 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "plt.figure(figsize=(14, 6))\n",
    "segment_sales['SEGMENT'] = segment_sales['LIFESTAGE'] + ' - ' + segment_sales['PREMIUM_CUSTOMER']\n",
    "plt.barh(segment_sales['SEGMENT'], segment_sales['TOT_SALES'], color='steelblue')\n",
    "plt.xlabel('Total Sales ($)')\n",
    "plt.title('Total Sales by Customer Segment')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "35a1db0b",
   "metadata": {},
   "source": [
    "###Deep dive \u2014 standout segments\n",
