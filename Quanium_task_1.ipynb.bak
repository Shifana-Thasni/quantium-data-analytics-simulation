   "source": [
    "merged['PRICE_PER_UNIT'] = merged['TOT_SALES'] / merged['PROD_QTY']\n",
    "avg_price = merged.groupby(['LIFESTAGE', 'PREMIUM_CUSTOMER'])['PRICE_PER_UNIT'].mean().reset_index()\n",
    "avg_price = avg_price.sort_values('PRICE_PER_UNIT', ascending=False)\n",
    "avg_price"
   ]
  },
