    }
   ],
   "source": [
    "daily_counts = transactions.groupby(transactions['DATE'].dt.date).size().reset_index(name='N')\n",
    "daily_counts['DATE'] = pd.to_datetime(daily_counts['DATE'])\n",
    "\n",
    "plt.figure(figsize=(14, 6))\n",
    "plt.plot(daily_counts['DATE'], daily_counts['N'])\n",
    "plt.xlabel('Date')\n",
    "plt.ylabel('Number of transactions')\n",
    "plt.title('Transactions Over Time')\n",
    "plt.xticks(rotation=90)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
